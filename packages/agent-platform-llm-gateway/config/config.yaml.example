# agent-platform-llm-gateway — LiteLLM Proxy 配置
# 复制到 /etc/agent-platform-llm-gateway/config.yaml 并填值

# === 后端模型清单 ===
# 后端 vLLM 跑在同机不同端口（参考 eval/llm/<model>/serve.sh）
# 生产建议 vLLM 跑独立 GPU 主机，这里 api_base 改 IP
model_list:
  - model_name: qwen-coder-32b
    litellm_params:
      model: openai/qwen-coder-32b
      api_base: http://localhost:8001/v1
      api_key: dummy
      timeout: 120
    model_info:
      mode: chat
      max_tokens: 32768

  - model_name: deepseek-coder-v2-lite
    litellm_params:
      model: openai/deepseek-coder-v2-lite
      api_base: http://localhost:8002/v1
      api_key: dummy
      timeout: 120
    model_info:
      mode: chat
      max_tokens: 32768

  - model_name: llama-3.3-70b
    litellm_params:
      model: openai/llama-3.3-70b
      api_base: http://localhost:8003/v1
      api_key: dummy
      timeout: 180
    model_info:
      mode: chat
      max_tokens: 16384

  # === Anthropic 协议别名路由 (Claude Code 用) ===
  # Claude Code 请求 claude-3-5-sonnet → 内部路由到本地大模型
  - model_name: claude-3-5-sonnet-20240620
    litellm_params:
      model: openai/qwen-coder-32b
      api_base: http://localhost:8001/v1
      api_key: dummy

# === 全局设置 ===
general_settings:
  master_key: sk-CHANGE-ME-master-key
  # PG schema 自动创建 (LiteLLM_*)
  database_url: postgresql://agent-platform:CHANGE-ME-pw@localhost:5432/agent_platform_gateway
  store_model_in_db: false
  health_check_interval: 60   # 秒，后端 vLLM 健康检查
  ui_username: admin
  ui_password: CHANGE-ME-admin

  # 默认路由策略
  routing_strategy: simple-shuffle
  num_retries: 1
  request_timeout: 300

litellm_settings:
  # 把每次请求落库 (spend tracking 喂 Console)
  success_callback: ["postgres"]
  failure_callback: ["postgres"]
  # 同时把请求日志按 user_id 维度切片
  set_verbose: false           # 生产环境 false；调试 true

  # === Task 1.5.3 + 1.5.4: 写 token_usage 到 C1 ===
  # 每次 LLM 调用同步发一行到 C1 (/api/ingest/token-usage)，
  # 供 C2 token 看板 / 配额引擎使用。
  # 环境变量：
  #   C1_INGEST_URL    控制面地址（默认 http://localhost:8000）
  #   C1_INGEST_TOKEN  共享服务 token（与 C1 settings.c1_ingest_service_token 一致）
  callbacks: ["agent_platform_llm_gateway.callbacks.UsageCallback"]

  # === Anthropic 协议（给 Claude Code）===
  # 不需要任何配置键：LiteLLM proxy 原生暴露 Anthropic /v1/messages，并提供
  # /anthropic/* pass-through，二者都走下面的 model_list 映射。Claude Code 直接
  # 指 ANTHROPIC_BASE_URL=<proxy>（统一端点）或 <proxy>/anthropic（pass-through）。
  # （曾经的 anthropic_passthrough_endpoint 不是 LiteLLM 配置键，会被静默忽略——
  #  validator 现在直接拒绝它，见 issue #351。）

  # === 限速 ===
  # 注意：litellm_settings.rpm / .tpm 不被 LiteLLM 消费（静默忽略，不限任何流，
  # 详见 issue #351 + https://docs.litellm.ai/docs/proxy/config_settings）。
  # 每用户限速是 virtual key 上的 rpm_limit / tpm_limit，由 C1 /key/generate 在
  # 发 key 时挂载（团队级则用 /team/new）。所以这里不再写 rpm/tpm。

# === Virtual Keys (per-user API key 体系) ===
# 真实 key 由 agent-platform-control 通过 /key/generate 动态发；本文件仅写一个"评测 master"
# user_id 必须与 agent-platform-control 的 user 表 id 对齐
#
# 示例（不要在生产 commit）：
# virtual_keys:
#   - key: sk-user-alice-abcd1234
#     user_id: alice                # 与 C1 users.id 对齐
#     models: [qwen-coder-32b, claude-3-5-sonnet-20240620]
#     max_budget: 100.0
#     budget_duration: 30d
#     rpm_limit: 100                # 每分钟请求数——LiteLLM 真正消费的 key 级限速
#     tpm_limit: 50000              # 每分钟 token（in+out）
#     # Task 1.5.3: 这三个字段会落到 LiteLLM kwargs.litellm_params.metadata，
#     # UsageCallback 据此把 token_usage 行的 user_id/tenant_id/agent 写对。
#     metadata:
#       user_id: alice
#       tenant_id: t-a
#       agent: claude-code          # claude-code | goose | qcoder
