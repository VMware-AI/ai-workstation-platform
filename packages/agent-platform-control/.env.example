# agent-platform-control · local dev .env (chmod 600)
# Mirror Settings fields in src/agent_platform_control/config.py.
# Copy to .env and edit values. Required vars are noted; the rest carry safe defaults.

# === DB ===
# Default SQLite is fine for dev; switch to postgresql+asyncpg://... for staging/prod.
AGENT_PLATFORM_DATABASE_URL=sqlite+aiosqlite:///./agent-platform-control.db

# === Auth ===
# DEV ONLY. Prod must source via Vaultwarden (C18) + Keycloak (C11 / OIDC).
AGENT_PLATFORM_ADMIN_API_TOKEN=dev-admin-token-CHANGE-ME
# SEC-2: the compiled default is now FALSE (secure by default) — with it off,
# the committed dev secrets above trip the startup fail-fast. Dev opts in here;
# prod MUST leave it off (and set a real ADMIN_API_TOKEN) or boot is refused.
AGENT_PLATFORM_ENABLE_FAKE_AUTH=true
AGENT_PLATFORM_DEPLOYMENT_TOKEN_FERNET_KEY=YWdlbnQtcGxhdGZvcm0tZGV2LWtleS0zMmJ5dGVzISE=
AGENT_PLATFORM_C1_INGEST_SERVICE_TOKEN=dev-ingest-token-CHANGE-ME

# === App ===
AGENT_PLATFORM_APP_NAME=agent-platform-control
AGENT_PLATFORM_LOG_LEVEL=INFO
# PR-F F-3: set to true for log-shipper-friendly JSON output.
AGENT_PLATFORM_LOG_JSON=false

# === Worker (PR-F F-1) ===
# Opt-in. Both fields must be set to start a worker.
AGENT_PLATFORM_ENABLE_WORKER=false
AGENT_PLATFORM_PROVISIONER_KIND=
# AGENT_PLATFORM_PROVISIONER_KIND=fake  # dev/test
# AGENT_PLATFORM_PROVISIONER_KIND=vmware  # prod — requires vSphere section below

# === vCenter (only needed when PROVISIONER_KIND=vmware) ===
AGENT_PLATFORM_VSPHERE_URL=
AGENT_PLATFORM_VSPHERE_USER=
AGENT_PLATFORM_VSPHERE_PASSWORD=
AGENT_PLATFORM_VSPHERE_TEMPLATE=
AGENT_PLATFORM_VSPHERE_VERIFY_SSL=true

# === Fileshare (W-5; UNC path on /api/me/instances) ===
# Empty → portal shows "—" instead of broken share path.
AGENT_PLATFORM_FILESHARE_BASE=

# === Quota (W-5 soft default) ===
AGENT_PLATFORM_QUOTA_TOTAL_TOKENS=1000000

# === ttyd (W-3.1 mock → W-3.2 real) ===
# real_mode=true → /api/me/instances/{id}/ttyd-url returns
#   wss://<vm.ip_address>:<TTYD_PORT>/ws (direct, no token; M1 trusts
#   NSX segment isolation, W-3.3 follow-up adds HMAC token sidecar).
# real_mode=false (default) → falls back to TTYD_MOCK_URL for dev demos
#   against `make ttyd-mock-up`. Empty TTYD_MOCK_URL + real_mode=false
#   makes the endpoint return 503 with a teaching detail.
AGENT_PLATFORM_TTYD_REAL_MODE=false
AGENT_PLATFORM_TTYD_PORT=7681
AGENT_PLATFORM_TTYD_MOCK_URL=
# SEC-1: trusted-network CIDR opened to the in-VM ttyd terminal (port 7681).
# Empty (default) = FAIL-CLOSED — install-agent.sh leaves 7681 firewalled.
# Set to the portal/control-plane NSX segment (e.g. 10.20.0.0/16) to enable the
# Terminal page. Rejected: the default route (0.0.0.0/0 · ::/0) and IPv6 zone
# ids — an invalid value fails worker startup (deep healthz → degraded).
AGENT_PLATFORM_WORKER_TTYD_ALLOW_CIDR=

# === Approval-triggered provisioning ===
AGENT_PLATFORM_DEFAULT_TENANT_ID=default
AGENT_PLATFORM_DEFAULT_IMAGE_VERSION=v0.1.0

# === Cleanup cron (PR-D decision 5) ===
AGENT_PLATFORM_CLEANUP_CRON_ENABLED=false
AGENT_PLATFORM_FAILED_VM_RETAIN_HOURS=24
