# agent-platform-secrets — environment template.
#
# Copy to .env (NEVER commit the populated file) and `chmod 600 .env`.

# Externally-resolvable hostname for the Vaultwarden instance. Used by
# Vaultwarden for cookie/CSRF scoping and by Caddy as the TLS SNI.
AGENT_PLATFORM_SECRETS_DOMAIN=https://secrets.agent-platform.internal

# Argon2id-hashed admin token. Generate with:
#   docker run --rm -it vaultwarden/server:1.32.4 /vaultwarden hash
# Vaultwarden stores ONLY the hash; the plain token goes into your
# password manager. Rotate any token that's been in shell history.
VAULTWARDEN_ADMIN_TOKEN=

# Set when running on a publicly-resolvable domain — Caddy registers
# this address with Let's Encrypt for ACME notifications. Leave empty
# for `tls internal` (Caddy CA) bring-up.
AGENT_PLATFORM_SECRETS_ACME_EMAIL=

# Override the host-side TLS ports if 80/443 are already taken on the
# control-plane host (e.g. by agent-platform-control's Caddy).
AGENT_PLATFORM_SECRETS_HTTP_PORT=80
AGENT_PLATFORM_SECRETS_HTTPS_PORT=443
