[Unit]
Description=agent-platform-secrets — Vaultwarden + Caddy
Documentation=https://github.com/VMware-AI/ai-workstation-platform/tree/main/packages/agent-platform-secrets
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

# Health-gated restart: the service exits non-zero if Vaultwarden does
# not pass its healthcheck within start-period, so systemd's restart
# policy retries until the host is actually ready (1.20.4 acceptance:
# Vaultwarden survives a host reboot without manual touch).

[Service]
Type=simple
WorkingDirectory=/opt/agent-platform-secrets
EnvironmentFile=/opt/agent-platform-secrets/.env
ExecStartPre=/usr/bin/docker compose -f docker-compose.yml pull --quiet
ExecStart=/usr/bin/docker compose -f docker-compose.yml up
ExecStop=/usr/bin/docker compose -f docker-compose.yml down

Restart=always
RestartSec=10

# systemd-side hardening: agent-platform-secrets only needs the docker socket.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/agent-platform-secrets
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
