# agent-platform-console · local dev .env
# Copy to .env.local (Vite picks it up). Only runtime-fetch URLs go here;
# the vite proxy in vite.config.ts hardcodes localhost:8000 for dev.

# Base URL the console hits at runtime. Set to control-plane URL in production.
# Leave commented for dev — the vite proxy (vite.config.ts) handles routing.
# VITE_CONTROL_BASE_URL=http://localhost:8000
