# agentplatform — required environment variables. Copy to .env and fill in.
# Never commit the resulting .env. Generate fresh secrets with openssl rand.

# Postgres — POSTGRES_PASSWORD has no default; docker-compose will fail without it.
POSTGRES_USER=agentplatform
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=agentplatform

# Connection strings used by the host dev server (127.0.0.1 → published ports).
# The compose worker does NOT read these — it derives its own from POSTGRES_*
# and connects by service name (postgres:5432 / redis:6379). So if you hand-edit
# DATABASE_URL (different user/db/password), also update POSTGRES_* to match, or
# web and worker will point at different databases (worker → "Instance not found").
DATABASE_URL=postgresql://agentplatform:CHANGE_ME@127.0.0.1:5432/agentplatform
REDIS_URL=redis://127.0.0.1:6379

# At-rest encryption key for ModelProvider.apiKey (32 bytes, hex). MANDATORY —
# crypto.ts throws at first use if missing.
ENCRYPTION_KEY=             # openssl rand -hex 32

# Public URL the control plane is reachable at (used by cloud-init to point
# agents back at /api/nodes/register).
NEXTAUTH_URL=http://localhost:3000

# Only needed to reach the DEV server from another machine on the LAN.
# Next blocks dev-server requests from unrecognized origins; list the host(s)
# you'll open in the browser, comma-separated, no scheme. Leave empty for
# localhost-only. Dev-only — no effect on production builds.
DEV_ALLOWED_ORIGINS=        # e.g. 172.20.20.6,192.168.1.50

# Agent self-registration (#231): base URL the provisioned VM calls back to
# (POST /api/nodes/register). Unset = bootstrap-token chain off; the worker's
# own vm.ip-wait path still marks instances RUNNING.
# CONTROL_PLANE_URL=http://192.168.206.175:3000

# Internal package mirror root for OFFLINE agent install (#286). Customer VMs
# boot with no public network/DNS, so goose/xiaoguai are pulled as tar archives
# from this operator-hosted mirror (HTTP/NAS/FTP) instead of github.com/PyPI.
# REQUIRED to deploy a known agent (goose|xiaoguai) — the generator fails fast
# with a teaching error if a known agent is chosen while this is unset. Not
# needed for "agent type = empty / free-form install commands" deploys.
# Mirror must host: goose-x86_64-unknown-linux-gnu.tar.bz2 (member ./goose) and
# xiaoguai-v<ver>-x86_64-unknown-linux-gnu.tar.gz — the latter must contain the
# `xiaoguai` binary at the tar ROOT (it is extracted straight into ~/.local/bin,
# no nested version dir), else the post-install `xiaoguai --version` check fails.
# AGENT_PKG_BASE_URL=http://mirror.internal/agents

# Sha256 of the mirrored xiaoguai tar.gz (SEC-3, fail-closed). REQUIRED for any
# xiaoguai deploy: cloud-init verifies the download with `sha256sum -c` before
# install, and generation fails fast with a teaching error if this is unset or
# not a 64-char lowercase hex digest. Compute against the exact asset you
# mirrored: sha256sum xiaoguai-v<ver>-x86_64-unknown-linux-gnu.tar.gz
# AGENT_XIAOGUAI_SHA256=

# Reaper: how long an instance may sit in PENDING/PROVISIONING/INITIALIZING/
# STOPPING before being swept to ERROR (ms). Default 2700000 (45 min).
# PROVISION_TIMEOUT_MS=2700000

# How many provision jobs the worker runs in parallel (#257 M22). Each job holds
# a slot up to ~5 min waiting for the VM's IP, so the old default 5 starved at 6
# simultaneous deploys. Default 10; lower it for a small vCenter, raise it if you
# routinely deploy many at once. Values above 50 are clamped to 50 (the ceiling)
# so a typo can't flood vCenter with concurrent IP waits. A change needs a worker
# restart to take effect.
# PROVISION_CONCURRENCY=10

# TEMP debug (#277): when set, the worker writes each VM's raw cloud-init
# userdata/metadata to this dir before injecting via govc. For troubleshooting a
# stuck deploy only — the files contain secrets (chmod 600); leave unset in
# production and delete the files after. Removable once provisioning is proven.
# CLOUDINIT_DEBUG_DIR=/tmp/agent-platform-cloudinit
