# M0.2 评测环境变量模板
# 复制到 eval/.env 并填值；不要 commit eval/.env

# === LLM 网关 (LiteLLM) ===
AGENT_PLATFORM_LLM_GATEWAY_URL=http://localhost:4000
AGENT_PLATFORM_LLM_API_KEY=sk-eval-master-key

# === vLLM 后端端口（每个 LLM 一个） ===
AGENT_PLATFORM_VLLM_QWEN_PORT=8001
AGENT_PLATFORM_VLLM_DEEPSEEK_PORT=8002
AGENT_PLATFORM_VLLM_LLAMA_PORT=8003

# === 权重下载/缓存目录 ===
AGENT_PLATFORM_MODELS_DIR=/data/models

# === Agent 超时 ===
AGENT_PLATFORM_AGENT_TIMEOUT_S=300

# === LLM-judge (评分用的中立 LLM) ===
AGENT_PLATFORM_JUDGE_BASE_URL=http://localhost:4000/v1
AGENT_PLATFORM_JUDGE_API_KEY=sk-eval-master-key
AGENT_PLATFORM_JUDGE_MODEL=qwen-coder-32b
AGENT_PLATFORM_JUDGE_TIMEOUT_S=30

# === HuggingFace 镜像 (可选) ===
# air-gap 客户 → 走内部镜像
# HF_ENDPOINT=https://hf-mirror.agent-platform.local

# === 内部 npm registry (可选) ===
# air-gap 客户 → 走内部 registry，agent install-all.sh 会用
# AGENT_PLATFORM_NPM_REGISTRY=https://npm.agent-platform.local

# === GPU 选择 ===
# CUDA_VISIBLE_DEVICES=0
