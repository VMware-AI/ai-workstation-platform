# M0.8 NSX DFW PoC env
# cp .env.example .env && chmod 600 .env
# .env 不进 git（含密码）

# === NSX-T Manager ===
NSX_HOST=nsx.lab.local
NSX_USER=agent-platform-poc
NSX_PASSWORD=
NSX_VERIFY_SSL=false       # lab self-signed; 生产 true

# === vCenter ===
VCENTER_HOST=vcenter.lab.local
VCENTER_USER=agent-platform-poc@vsphere.local
VCENTER_PASSWORD=
VCENTER_VERIFY_SSL=false

# === 已有 NSX/vCenter 对象（摸底问卷填好后回填）===
COMPUTE_CLUSTER=lab-cluster-01
TRANSPORT_ZONE=tz-overlay-01
T1_GATEWAY=t1-agent-platform
TEMPLATE_VM=ubuntu-2204-template

# === 测试租户配置 ===
TENANT_A_CIDR=10.50.10.0/24
TENANT_B_CIDR=10.50.20.0/24

# === 模拟员工 PC / FS / LLM IP（lab 上找 3 台机器或起 3 容器）===
TENANT_A_PCS=10.20.1.0/24
TENANT_A_FS=10.30.1.5
TENANT_A_LLM=10.30.1.10
TENANT_B_PCS=10.20.2.0/24
TENANT_B_FS=10.30.2.5
TENANT_B_LLM=10.30.2.10
